# Copy to backend/.env and adjust.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=university_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Only needed if the frontend is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origins allowed to submit forms to Django (admin login/logout) behind a proxy.
# CSRF_TRUSTED_ORIGINS=https://portal.example.edu

# Name and address printed on receipts and invoices.
UNIVERSITY_NAME=BULACODE UNIVERSITY
# UNIVERSITY_ADDRESS=Office of Student Accounts (Bursary), 1 University Road, Lagos

# SMTP for emailing receipts. Without EMAIL_HOST, emails are printed to the console.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=BULACODE UNIVERSITY Bursary <bursary@bulacode.edu.ng>

# Bank account students pay into offline (shown on the portal and on invoices).
# BURSARY_BANK_NAME=First Bank of Nigeria
# BURSARY_ACCOUNT_NAME=Bulacode University Fees Account
# BURSARY_ACCOUNT_NUMBER=0123456789
# Email the bursary when a student uploads proof of payment.
# BURSARY_NOTIFY_EMAIL=bursary@bulacode.edu.ng

# Links in emails point here.
# PORTAL_URL=https://portal.bulacode.edu.ng

# SMS alerts via Termii (https://termii.com). Without these, SMS are only logged.
# SMS_BACKEND=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=BULACODE

# Course registration limits (units per semester)
# MIN_UNITS_PER_SEMESTER=15
# MAX_UNITS_PER_SEMESTER=24

# Attendance: how often the QR/6-digit check-in code changes, and the minimum attendance
# a student needs (below it they are warned and flagged in reports).
# ATTENDANCE_CODE_SECONDS=20
# ATTENDANCE_MIN_PERCENT=75

# Examinations: whether overdue fees stop a student sitting exams (1/0), how long after a CBT's time
# runs out answers are still accepted (network delay), and how many times leaving the exam page
# flags a candidate for the lecturer.
# EXAM_REQUIRE_FEES_CLEARED=1
# EXAM_ANSWER_GRACE_SECONDS=10
# EXAM_FOCUS_FLAG_AFTER=3

# Paystack keys (use sk_test_... while testing). Every online payment goes through Paystack; without a key,
# online payment is switched off (students pay at the bank and upload proof of payment).
PAYSTACK_SECRET_KEY=
# Optional: override where Paystack redirects after checkout.
# PAYSTACK_CALLBACK_URL=https://portal.example.edu/portal/fees/paystack/callback

# Set to 1 to use a throwaway SQLite file instead of PostgreSQL.
# USE_SQLITE=0

# Website chatbot: an Anthropic API key (https://console.anthropic.com) makes it answer with Claude.
# Without a key it still works, answering common questions from built-in answers.
# ANTHROPIC_API_KEY=
# CHATBOT_MODEL=claude-sonnet-5

